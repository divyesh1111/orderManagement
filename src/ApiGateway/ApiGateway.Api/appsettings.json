{
  "ServiceUrls": {
    "Product": "http://product-service:8080",
    "Customer": "http://customer-service:8080",
    "Order": "http://order-service:8080",
    "Notification": "http://notification-service:8080"
  },
  "ReverseProxy": {
    "Routes": {
      "products_api": {
        "ClusterId": "productCluster",
        "Match": { "Path": "/api/products/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api" }]
      },
      "customers_api": {
        "ClusterId": "customerCluster",
        "Match": { "Path": "/api/customers/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api" }]
      },
      "orders_api": {
        "ClusterId": "orderCluster",
        "Match": { "Path": "/api/orders/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api" }]
      },
      "notifications_api": {
        "ClusterId": "notificationCluster",
        "Match": { "Path": "/api/notifications/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api" }]
      },
      "products_root": {
        "ClusterId": "productCluster",
        "Match": { "Path": "/products/{**catch-all}" }
      },
      "customers_root": {
        "ClusterId": "customerCluster",
        "Match": { "Path": "/customers/{**catch-all}" }
      },
      "orders_root": {
        "ClusterId": "orderCluster",
        "Match": { "Path": "/orders/{**catch-all}" }
      },
      "notifications_root": {
        "ClusterId": "notificationCluster",
        "Match": { "Path": "/notifications/{**catch-all}" }
      }
    },
    "Clusters": {
      "productCluster": { "Destinations": { "d1": { "Address": "http://product-service:8080/" } } },
      "customerCluster": { "Destinations": { "d1": { "Address": "http://customer-service:8080/" } } },
      "orderCluster": { "Destinations": { "d1": { "Address": "http://order-service:8080/" } } },
      "notificationCluster": { "Destinations": { "d1": { "Address": "http://notification-service:8080/" } } }
    }
  }
}