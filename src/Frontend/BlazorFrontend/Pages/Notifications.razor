@page "/notifications"
@inject NotificationsApi Api

<h3>Notifications</h3>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span class="fw-semibold">Logs</span>
    <button class="btn btn-sm btn-outline-secondary" @onclick="LoadAsync" disabled="@busy">Refresh</button>
  </div>
  <div class="card-body">
    @if (!string.IsNullOrWhiteSpace(error))
    {
      <div class="alert alert-danger">@error</div>
    }

    @if (items.Count == 0 && string.IsNullOrWhiteSpace(error))
    {
      <div class="text-muted">No notifications yet</div>
    }
    else
    {
      <div class="table-responsive">
        <table class="table table-sm table-striped">
          <thead>
            <tr>
              <th>Time</th>
              <th>Message</th>
              <th>Order Id</th>
              <th>Id</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var n in items)
            {
              <tr>
                <td>@n.CreatedAtUtc</td>
                <td>@n.Message</td>
                <td class="text-muted" style="font-size:12px">@n.OrderId</td>
                <td class="text-muted" style="font-size:12px">@n.Id</td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    }
  </div>
</div>

@code {
  List<NotificationReadDto> items = [];
  bool busy;
  string error = "";

  protected override async Task OnInitializedAsync() => await LoadAsync();

  async Task LoadAsync()
  {
    busy = true;
    error = "";
    try
    {
      items = await Api.GetAllAsync(CancellationToken.None);
      items = items.OrderByDescending(x => x.CreatedAtUtc).ToList();
    }
    catch (Exception ex)
    {
      error = ex.Message;
    }
    finally
    {
      busy = false;
    }
  }
}