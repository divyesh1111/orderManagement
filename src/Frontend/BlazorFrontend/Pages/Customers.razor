@page "/customers"
@inject CustomersApi Api

<h3>Customers</h3>

<div class="row g-3">
  <div class="col-lg-5">
    <div class="card shadow-sm">
      <div class="card-header">Add Customer</div>
      <div class="card-body">
        <EditForm Model="form" OnValidSubmit="CreateAsync">
          <div class="mb-2">
            <label class="form-label">First Name</label>
            <InputText class="form-control" @bind-Value="form.FirstName" />
          </div>
          <div class="mb-2">
            <label class="form-label">Last Name</label>
            <InputText class="form-control" @bind-Value="form.LastName" />
          </div>
          <div class="mb-2">
            <label class="form-label">Email</label>
            <InputText class="form-control" @bind-Value="form.Email" />
          </div>
          <button class="btn btn-primary" type="submit" disabled="@busy">Add</button>
        </EditForm>

        @if (!string.IsNullOrWhiteSpace(error))
        {
          <div class="alert alert-danger mt-3 mb-0">@error</div>
        }

        @if (!string.IsNullOrWhiteSpace(message))
        {
          <div class="alert alert-success mt-3 mb-0">@message</div>
        }
      </div>
    </div>
  </div>

  <div class="col-lg-7">
    <div class="card shadow-sm">
      <div class="card-header d-flex justify-content-between align-items-center gap-3">
        <span>All Customers</span>
        <div class="d-flex gap-2">
          <InputText class="form-control form-control-sm" placeholder="Search name or email" @bind-Value="query" />
          <button class="btn btn-sm btn-outline-secondary" @onclick="LoadAsync" disabled="@busy">Refresh</button>
        </div>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-sm table-striped align-middle">
            <thead>
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Id</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var c in Filtered())
              {
                <tr>
                  <td class="fw-semibold">@c.FirstName @c.LastName</td>
                  <td>@c.Email</td>
                  <td class="text-muted" style="font-size:12px">@c.Id</td>
                </tr>
              }
            </tbody>
          </table>

          @if (items.Count == 0)
          {
            <div class="text-muted">No customers</div>
          }
        </div>
      </div>
    </div>
  </div>
</div>

@code {
  sealed class CustomerForm
  {
    public string FirstName { get; set; } = "";
    public string LastName { get; set; } = "";
    public string Email { get; set; } = "";
  }

  List<CustomerReadDto> items = [];
  CustomerForm form = new();
  bool busy;
  string error = "";
  string message = "";
  string query = "";

  protected override async Task OnInitializedAsync() => await LoadAsync();

  IEnumerable<CustomerReadDto> Filtered()
  {
    var q = (query ?? "").Trim();
    return items
      .Where(x =>
        string.IsNullOrWhiteSpace(q) ||
        (x.FirstName + " " + x.LastName).Contains(q, StringComparison.OrdinalIgnoreCase) ||
        x.Email.Contains(q, StringComparison.OrdinalIgnoreCase))
      .OrderBy(x => x.FirstName)
      .ThenBy(x => x.LastName);
  }

  async Task LoadAsync()
  {
    busy = true;
    error = "";
    message = "";
    try
    {
      items = await Api.GetAllAsync(CancellationToken.None);
    }
    catch (Exception ex)
    {
      error = ex.Message;
    }
    finally
    {
      busy = false;
    }
  }

  async Task CreateAsync()
  {
    busy = true;
    error = "";
    message = "";
    try
    {
      var created = await Api.CreateAsync(new CustomerCreateDto(form.FirstName, form.LastName, form.Email), CancellationToken.None);
      if (created is null)
      {
        error = "Create failed";
        return;
      }

      message = "Customer added";
      form = new CustomerForm();
      await LoadAsync();
    }
    catch (Exception ex)
    {
      error = ex.Message;
    }
    finally
    {
      busy = false;
    }
  }
}